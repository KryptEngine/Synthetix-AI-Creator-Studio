# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
PORT=3001
APP_URL="http://localhost:3000"
NODE_ENV=development

# Where the JSON store writes users, sessions, encrypted provider keys and the
# studio dataset. Defaults to <cwd>/.data. On Render/Railway point it at the
# mounted volume so the data survives a redeploy:
#   Render  → /opt/render/project/src/.data
#   Railway → /app/.data
# DATA_DIR="/app/.data"

# 64 hex characters (32 bytes). Used to encrypt provider API keys at rest.
# Generate a fresh one for every deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------------
# Super admin account (seeded on first boot)
# ---------------------------------------------------------------------------
# Change both before deploying. ADMIN_PASSWORD stays authoritative for the
# auto-seeded admin until the password is changed from inside the app.
ADMIN_EMAIL=admin@synthetix.ai
ADMIN_PASSWORD=Synthetix@2026
ADMIN_NAME=Alex Reed (Synthetix)

# ---------------------------------------------------------------------------
# Payments — Razorpay (marketplace checkout)
# ---------------------------------------------------------------------------
# Dashboard → Settings → API Keys. Leave blank to run without payments; the
# marketplace then reports "payments not configured" instead of failing.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Dashboard → Settings → Webhooks → secret for the webhook you create.
RAZORPAY_WEBHOOK_SECRET=""

# RazorpayX account used for creator payouts. Payouts stay in escrow and are
# queued for manual settlement when this is blank.
RAZORPAY_PAYOUT_ACCOUNT_ID=""

# ---------------------------------------------------------------------------
# Transport / CORS
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Only needed
# when the frontend is served from a different host than the API.
# CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Set to "on" when serving over HTTPS so session cookies get the Secure flag
# and HSTS is enabled.
# HTTPS=on
# COOKIE_SECURE=on

# ---------------------------------------------------------------------------
# Optional free-provider credentials. Each line is an env var name that the
# backend looks up. Configured providers rotate automatically.
# GEMINI_API_KEY="..."
# GROQ_API_KEY="..."
# CEREBRAS_API_KEY="..."
# NVIDIA_API_KEY="..."
# OPENROUTER_API_KEY="..."
# HF_TOKEN="..."
# MISTRAL_API_KEY="..."
# LLM7_API_KEY="..."
# SILICONFLOW_API_KEY="..."
# SAMBANOVA_API_KEY="..."
# DEEPSEEK_API_KEY="..."
# XAI_API_KEY="..."
# AI21_API_KEY="..."
# CHUTES_API_KEY="..."
# NEBIUS_API_KEY="..."
# NSCALE_API_KEY="..."
# GLHF_API_KEY="..."
# MODELSCOPE_API_KEY="..."
# OPENCODE_API_KEY="..."
# KILO_API_KEY="..."
# OVH_API_KEY="..."
# ZHIPU_AI_API_KEY="..."
# AION_API_KEY="..."
# DASHSCOPE_API_KEY="..."
# AGNES_AI_API_KEY="..."
# OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
